### 서버 접근용 환경변수
# 프로젝트 모드
NODE_ENV=development

# SSL 인증서
SSL_KEY_PATH=src/config/https/localhost-key.pem
SSL_CERT_PATH=src/config/https/localhost.pem

# API 서버 URL
API_URL_PROD=https://ec2-54-180-118-74.ap-northeast-2.compute.amazonaws.com
WS_URL_PROD=wss://ec2-54-180-118-74.ap-northeast-2.compute.amazonaws.com
# 로컬 개발용
API_URL_LOCAL=https://localhost:8080
WS_URL_LOCAL=wss://localhost:8080


### 클라이언트 접근 가능한 환경변수 설정 (NEXT_PUBLIC_)
NEXT_PUBLIC_NODE_ENV=development

