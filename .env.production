# Nextjs는 .env 파일 자동 로드. Express 는 dotenv로 명시적으로 로드해줘야 함


### 서버 접근용 환경변수
# 프로젝트 모드
NODE_ENV=production

# SSL 인증서
SSL_KEY_PATH=src/config/https/localhost-key.pem
SSL_CERT_PATH=src/config/https/localhost.pem
SSL_CA_PATH=src/config/https/ec2-public-ip.crt


### 클라이언트 접근 가능한 환경변수 설정 (NEXT_PUBLIC_)
# API 서버 URL
NEXT_PUBLIC_API_SERVER_HOST=ec2-3-36-70-95.ap-northeast-2.compute.amazonaws.com
NEXT_PUBLIC_API_URL=https://ec2-3-36-70-95.ap-northeast-2.compute.amazonaws.com
