### 서버 접근용 환경변수
# 프로젝트 모드
NODE_ENV=production

# Railway 배포 서버 사용 여부
USE_REMOTE_API=true

# HTTPS 사용여부 및 SSL 인증서
USE_HTTPS=false
SSL_KEY_PATH=src/config/https/localhost-key.pem
SSL_CERT_PATH=src/config/https/localhost.pem

# API 서버 URL
API_URL_PROD=http://jilolgg-api.railway.internal:8080
WS_URL_PROD=ws://jilolgg-api.railway.internal:8080


### 클라이언트 접근 가능한 환경변수 설정 (NEXT_PUBLIC_)
NEXT_PUBLIC_NODE_ENV=production
